{
  "app_config": {
    "app_name": "BithermManagement",
    "package_name": "com.bithermmanagement",
    "version_name": "1.0",
    "version_code": 1
  },
  "login_module": {
    "splash_screen": {
      "duration_ms": 2000,
      "logo_path": "@drawable/ic_launcher_foreground",
      "background_color": "@color/white",
      "text_color": "@color/black"
    },
    "login_screen": {
      "title": "Iniciar Sesión",
      "username_hint": "Usuario",
      "password_hint": "Contraseña",
      "login_button_text": "Entrar",
      "forgot_password_text": "¿Olvidaste tu contraseña?",
      "background_color": "@color/white",
      "primary_color": "@color/purple_500",
      "error_color": "@color/red_500"
    },
    "biometric": {
      "enabled": true,
      "title": "Autenticación Biométrica",
      "subtitle": "Usa tu huella dactilar o PIN",
      "negative_button": "Cancelar"
    }
  },
  "google_sheets": {
    "spreadsheet_id": "",
    "credentials_file": "credentials2.json",
    "sheets": {
      "users": {
        "name": "Usuarios",
        "columns": {
          "username": "A",
          "password": "B",
          "name": "C",
          "email": "D",
          "role": "E",
          "active": "F",
          "last_login": "G"
        }
      }
    }
  },
  "user_data_fields": [
    "username",
    "name", 
    "email",
    "role",
    "permissions",
    "preferences"
  ],
  "navigation": {
    "main_activity": "MainActivity",
    "login_activity": "LoginActivity",
    "splash_activity": "SplashActivity"
  },
  "debug_config": {
    "enabled": false,
    "show_popups": true,
    "show_background_colors": true,
    "log_level": "DEBUG",
    "popup_delay_ms": 3000,
    "gesture_activation": {
      "triple_tap_enabled": true,
      "double_tap_enabled": true,
      "tap_timeout_ms": 500
    },
    "overlay": {
      "position": "top_right",
      "auto_hide": true,
      "auto_hide_delay_ms": 3000,
      "background_color": "#1A000000",
      "text_color": "#FFFFFF"
    },
    "features": {
      "fragment_tracking": true,
      "layout_analysis": true,
      "view_hierarchy": true,
      "performance_monitoring": true
    }
  }
} 