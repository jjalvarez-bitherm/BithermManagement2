<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bitherm_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nueva Solicitud de Ausencia"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Empleado -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Empleado"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/gray_700"
            app:hintTextColor="@color/gray_700">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextEmployeeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Cargando..."
                android:textColor="@color/black" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fecha de Solicitud -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Fecha de Solicitud"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/gray_700"
            app:hintTextColor="@color/gray_700">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextRequestDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:textColor="@color/black" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tipo de Ausencia -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAbsenceType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Tipo de Ausencia"
            style="@style/CustomTextInputLayout.ExposedDropdownMenu"
            app:hintTextColor="@color/black"
            app:expandedHintEnabled="true">

            <AutoCompleteTextView
                android:id="@+id/spinnerAbsenceType"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:textColor="@color/black"
                android:background="@null"
                android:gravity="center_vertical"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:completionThreshold="1"
                android:dropDownWidth="match_parent"
                android:dropDownHorizontalOffset="0dp"
                android:dropDownVerticalOffset="0dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fechas y Días Laborables en línea -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Fecha de Inicio -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStartDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="Fecha de Inicio"
                style="@style/CustomTextInputLayout"
                app:hintTextColor="@color/black"
                app:expandedHintEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextStartDate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textColor="@color/black"
                    android:clickable="true"
                    android:focusable="true"
                    android:inputType="none"
                    android:hint=""
                    android:gravity="center_vertical" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Días Laborables en el centro -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWorkingDays"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:hint="Días"
                style="@style/CustomTextInputLayout"
                app:hintTextColor="@color/black"
                app:expandedHintEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextWorkingDays"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:enabled="false"
                    android:text="0"
                    android:textColor="@color/black"
                    android:gravity="center" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Fecha de Fin -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEndDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="Fecha de Fin"
                style="@style/CustomTextInputLayout"
                app:hintTextColor="@color/black"
                app:expandedHintEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEndDate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textColor="@color/black"
                    android:clickable="true"
                    android:focusable="true"
                    android:inputType="none"
                    android:hint=""
                    android:gravity="center_vertical" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Motivo de Solicitud -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Motivo de Solicitud"
            style="@style/CustomTextInputLayout"
            app:hintTextColor="@color/black"
            app:expandedHintEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/black"
                android:minLines="2"
                android:maxLines="4" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/buttonCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/buttonSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviar Solicitud"
                android:backgroundTint="@color/blue_600" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
