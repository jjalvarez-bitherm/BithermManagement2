<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Información GPS -->
    <TextView
        android:id="@+id/tv_gps_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Información GPS"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="12dp" />

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginBottom="16dp" />

    <!-- Switch Debug -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🐛 Modo Debug"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

        <Switch
            android:id="@+id/switch_debug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />

    </LinearLayout>

    <!-- Switch Sincronización -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔄 Sincronización"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

        <Switch
            android:id="@+id/switch_sincronizacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />

    </LinearLayout>

    <!-- Switch Debug Escritura -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✏️ Debug Escritura"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

        <Switch
            android:id="@+id/switch_debug_escritura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />

    </LinearLayout>

    <!-- Configuración de umbral de sincronización -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        android:id="@+id/layout_umbral_sync">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📊 Umbral de sincronización:"
            android:textSize="14sp"
            android:textColor="@android:color/black" />

        <EditText
            android:id="@+id/et_umbral_sync"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="10"
            android:textSize="14sp"
            android:textAlignment="center"
            android:background="@drawable/bg_edittext_dark"
            android:textColor="@android:color/black"
            android:hint="10" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" equipos"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Botón Sincronizar -->
    <Button
        android:id="@+id/btn_sincronizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SINCRONIZAR"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/azul_bitherm"
        android:layout_marginTop="8dp"
        android:enabled="false" />

    <!-- Botón Limpiar Colores Debug -->
    <Button
        android:id="@+id/btn_limpiar_colores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🧹 LIMPIAR COLORES DEBUG"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/md_theme_errorContainer"
        android:layout_marginTop="8dp"
        android:enabled="false" />

</LinearLayout>
