<resources>
    <!-- Base application theme. -->
    <style name="Theme.BithermManagement.Navigation" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/bitherm_blue</item>
        <item name="colorPrimaryVariant">@color/bitherm_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/bitherm_blue</item>
        <item name="colorSecondaryVariant">@color/bitherm_green</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.BithermManagement.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.BithermManagement.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>

