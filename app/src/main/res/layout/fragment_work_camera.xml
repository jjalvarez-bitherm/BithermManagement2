<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bitherm_gradient_background"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <!-- Botones de Acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Fila 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGPS"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="0.95"
                android:layout_marginEnd="8dp"
                android:text="GPS"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_gps_fixed"
                app:iconGravity="start"
                app:iconSize="28dp"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#00796B"
                app:cornerRadius="12dp"
                app:elevation="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDenuncia"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1.05"
                android:layout_marginStart="8dp"
                android:text="DENUNCIA"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_report"
                app:iconGravity="start"
                app:iconSize="28dp"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#D32F2F"
                app:cornerRadius="12dp"
                app:elevation="4dp" />

        </LinearLayout>

        <!-- Fila 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNota"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="0.95"
                android:layout_marginEnd="8dp"
                android:text="NOTA"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_note"
                app:iconGravity="start"
                app:iconSize="28dp"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#1976D2"
                app:cornerRadius="12dp"
                app:elevation="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProyecto"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1.05"
                android:layout_marginStart="8dp"
                android:text="PROYECTO"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_work"
                app:iconGravity="start"
                app:iconSize="28dp"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#7B1FA2"
                app:cornerRadius="12dp"
                app:elevation="4dp" />

        </LinearLayout>

        <!-- Separador Visual -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginBottom="32dp"
            android:background="#40FFFFFF" />

        <!-- Galería (separada visualmente y más abajo) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGaleria"
            android:layout_width="220dp"
            android:layout_height="90dp"
            android:layout_marginTop="8dp"
            android:text="GALERÍA"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            app:icon="@drawable/ic_photo_library"
            app:iconGravity="start"
            app:iconSize="32dp"
            app:iconTint="#FFFFFF"
            app:backgroundTint="#FF9800"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="2dp" />

    </LinearLayout>

</LinearLayout>

