<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bitherm_gradient"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="64dp">

        <!-- Card: Análisis de Tiempos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/black"
            android:elevation="6dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Análisis de Tiempos"
                    android:textStyle="bold"
                    android:textColor="@color/azul_bitherm"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Filtros -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <!-- Período -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Período:"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinner_periodo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"/>

                    <!-- Usuario -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usuario:"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinner_usuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"/>

                    <!-- Vista -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vista:"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinner_vista"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"/>

                    <!-- Fechas personalizadas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <Button
                            android:id="@+id/btn_fecha_inicio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fecha Inicio"
                            android:backgroundTint="@color/azul_bitherm"
                            android:textColor="@android:color/white"
                            android:layout_marginEnd="4dp"/>

                        <Button
                            android:id="@+id/btn_fecha_fin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fecha Fin"
                            android:backgroundTint="@color/azul_bitherm"
                            android:textColor="@android:color/white"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>

                    <!-- Botones de acción -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_generar_reporte"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Generar Reporte"
                            android:backgroundTint="@color/verde_bitherm"
                            android:textColor="@android:color/black"
                            android:layout_marginEnd="4dp"/>

                        <Button
                            android:id="@+id/btn_exportar_reporte"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Exportar"
                            android:backgroundTint="@color/azul_bitherm"
                            android:textColor="@android:color/white"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Resultados -->
                <LinearLayout
                    android:id="@+id/layout_resultados_analisis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView> 