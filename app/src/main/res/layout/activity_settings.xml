<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bitherm_gradient">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Configuración"
            app:titleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Configuración de Google Cloud -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                                         <TextView
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:text="Configuración de Google Cloud"
                         android:textSize="18sp"
                         android:textStyle="bold"
                         android:layout_marginBottom="16dp" />

                     <!-- Selector de método de autenticación -->
                     <RadioGroup
                         android:id="@+id/rgAuthMethod"
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="vertical"
                         android:layout_marginBottom="16dp">

                         <RadioButton
                             android:id="@+id/rbOAuth"
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:text="Usar cuenta de Google (OAuth)" />

                         <RadioButton
                             android:id="@+id/rbServiceAccount"
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:text="Cuenta de servicio" />

                     </RadioGroup>

                     <!-- Selector de credenciales para cuenta de servicio -->
                     <LinearLayout
                         android:id="@+id/layoutServiceAccountOptions"
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="vertical"
                         android:layout_marginBottom="16dp">

                         <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="Opciones de credenciales:"
                             android:textStyle="bold"
                             android:layout_marginBottom="8dp" />

                         <RadioGroup
                             android:id="@+id/rgCredentials"
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:orientation="vertical">

                             <RadioButton
                                 android:id="@+id/rbDefaultCredentials"
                                 android:layout_width="match_parent"
                                 android:layout_height="wrap_content"
                                 android:text="Usar credenciales por defecto (recomendado)" />

                             <RadioButton
                                 android:id="@+id/rbCustomCredentials"
                                 android:layout_width="match_parent"
                                 android:layout_height="wrap_content"
                                 android:text="Subir credenciales personalizadas" />

                         </RadioGroup>

                     </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilProjectId"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Project ID">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etProjectId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilServiceAccountEmail"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Service Account Email">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etServiceAccountEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSpreadsheetId"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Spreadsheet ID">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSpreadsheetId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDriveFolderId"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Drive Folder ID">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDriveFolderId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadCredentials"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Subir archivo de credenciales"
                        android:backgroundTint="@color/bitherm_blue" />

                                         <com.google.android.material.button.MaterialButton
                         android:id="@+id/btnDownloadCredentials"
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:text="Descargar credenciales actuales"
                         style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                         android:layout_marginTop="8dp" />

                     <!-- Botón para conectar con Google (OAuth) -->
                     <com.google.android.material.button.MaterialButton
                         android:id="@+id/btnConnectGoogle"
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:text="Conectar con Google"
                         android:backgroundTint="@color/bitherm_blue"
                         android:layout_marginTop="8dp" />

                     <TextView
                         android:id="@+id/tvGoogleAccount"
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:text="No conectado"
                         android:textAlignment="center"
                         android:layout_marginTop="8dp"
                         android:textColor="@android:color/darker_gray" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Configuración de la empresa -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configuración de la empresa"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCompanyName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Nombre de la empresa">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCompanyName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Nombre de la aplicación de cámara -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCameraAppName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Nombre de la aplicación de cámara">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCameraAppName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:text="BithermCAM" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Nombre del sistema de gestión -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilManagementSystemName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Nombre del sistema de gestión">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etManagementSystemName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:text="Bitherm Management" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Nombre del chat -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilChatAppName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Nombre del sistema de chat">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etChatAppName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:text="Bitherm Chat" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadLogo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Subir logo de la empresa"
                        android:backgroundTint="@color/bitherm_blue" />

                    <ImageView
                        android:id="@+id/ivCompanyLogo"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_image_placeholder"
                        android:scaleType="centerCrop" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Configuración de horarios -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configuración de horarios"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Horario de trabajo:"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="8dp" />

                        <TimePicker
                            android:id="@+id/timePickerStart"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:timePickerMode="spinner" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="a"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="8dp" />

                        <TimePicker
                            android:id="@+id/timePickerEnd"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:timePickerMode="spinner" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Botones de acción -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Guardar configuración"
                    android:backgroundTint="@color/bitherm_blue"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestConnection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Probar conexión"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Restablecer configuración"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="@android:color/holo_red_dark"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearOAuthSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Limpiar configuración OAuth"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="@android:color/holo_orange_dark" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
