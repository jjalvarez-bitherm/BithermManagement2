    // Para centrar el dropdown en pantalla, se usará un Dialog personalizado
    private fun showCenteredDropdown(title: String, items: List<String>, onSelect: (String) -> Unit) {
        val dialog = android.app.AlertDialog.Builder(requireContext())
            .setTitle(title)
            .setItems(items.toTypedArray()) { d, which ->
                onSelect(items[which])
                d.dismiss()
            }
            .setNegativeButton("Cancelar", null)
            .create()
        dialog.show()
        // Centrar el diálogo
        val window = dialog.window
        window?.setLayout(
            (resources.displayMetrics.widthPixels * 0.85).toInt(),
            android.view.WindowManager.LayoutParams.WRAP_CONTENT
        )
        window?.setGravity(android.view.Gravity.CENTER)
    }

    private fun cargarColoresEstados(): Map<String, Int> {
        val map = mutableMapOf<String, Int>()
        val json = JSONObject(requireContext().assets.open("estados_colores.json").bufferedReader().use { it.readText() })
        json.keys().forEach { estado ->
            val colorHex = json.getString(estado)
            try {
                val estadoKey = estado.uppercase().trim()
                val colorInt = android.graphics.Color.parseColor(colorHex)
                map[estadoKey] = colorInt
            } catch (e: Exception) {
                android.util.Log.w("ColoresEstados", "Color inválido para estado $estado: $colorHex")
            }
        }
        return map
    }

    private fun actualizarModelosPorMarca(marca: String) {
        Log.d("FragmentInspeccionEquipo", "Actualizando modelos para marca: $marca")
        lifecycleScope.launch {
            try {
                Log.d("SpinnerDebug", "Antes de obtener modelos para marca '$marca'")
                val modelos = inspeccionDao.getModelosUnicosPorMarcas(listOf(marca))
                Log.d("SpinnerDebug", "Modelos para marca '$marca': $modelos")
                val adapter = ArrayAdapter(requireContext(), android.R.layout.simple_dropdown_item_1line, modelos.toList())
                spinnerModelo.setAdapter(adapter)
                // Limpiar selección actual
                spinnerModelo.setText("", false)
                // Actualizar tipos por marca y modelo
                actualizarTiposPorMarcaModelo(marca, "")
            } catch (e: Exception) {
                Log.e("SpinnerDebug", "Error al obtener modelos: ${e.message}", e)
            }
        }
    }

    private fun actualizarTiposPorMarcaModelo(marca: String, modelo: String) {
        Log.d("FragmentInspeccionEquipo", "Actualizando tipos para marca: $marca, modelo: $modelo")
        lifecycleScope.launch {
            try {
                val tipos = if (marca.isNotEmpty() && modelo.isNotEmpty()) {
                    inspeccionDao.getTiposUnicosPorMarcaModelo(marca, modelo)
                } else {
                    inspeccionDao.getTiposUnicos()
                }
                Log.d("SpinnerDebug", "Tipos para marca '$marca' y modelo '$modelo': $tipos")
                val adapter = ArrayAdapter(requireContext(), android.R.layout.simple_dropdown_item_1line, tipos.toList())
                spinnerTipo.setAdapter(adapter)
                // Limpiar selección actual
                spinnerTipo.setText("", false)
            } catch (e: Exception) {
                Log.e("SpinnerDebug", "Error al obtener tipos: ${e.message}", e)
            }
        }
    }

    private fun actualizarPresionesSalidaPorEntrada(presionEntrada: String) {
        Log.d("FragmentInspeccionEquipo", "Actualizando presiones de salida para entrada: $presionEntrada")
        lifecycleScope.launch {
            try {
                val presionesSalida = if (presionEntrada.isNotEmpty()) {
                    // Obtener presiones de salida menores que la de entrada
                    inspeccionDao.getPresionesSalidaMenoresQue(presionEntrada)
                } else {
                    inspeccionDao.getPresionesSalidaUnicas()
                }
                Log.d("SpinnerDebug", "Presiones de salida para entrada '$presionEntrada': $presionesSalida")
                val adapter = ArrayAdapter(requireContext(), android.R.layout.simple_dropdown_item_1line, presionesSalida.toList())
                spinnerPresSalida.setAdapter(adapter)
                // Limpiar selección actual
                spinnerPresSalida.setText("", false)
            } catch (e: Exception) {
                Log.e("SpinnerDebug", "Error al obtener presiones de salida: ${e.message}", e)
            }
        }
    }

    private fun navegarPurgador(direccion: Int) {
        Log.d("NavegacionPurgador", "Intentando navegar. Índice actual: $indiceActual, dirección: $direccion, total: ${listaEquipos.size}")
        if (listaEquipos.isEmpty()) return
        val nuevoIndice = indiceActual + direccion
        if (nuevoIndice in listaEquipos.indices) {
            Log.d("NavegacionPurgador", "Navegando a índice: $nuevoIndice (ID: ${listaEquipos[nuevoIndice].id})")
            indiceActual = nuevoIndice
            equipo = listaEquipos[indiceActual]
            Log.d("NavegacionPurgador", "Nuevo equipo seleccionado: $equipo")
            cargarDatosEquipo()
        } else {
            Log.d("NavegacionPurgador", "Índice fuera de rango: $nuevoIndice")
        }
    }

    private fun setupEstadoDropdown() {
        lifecycleScope.launch {
            try {
                val estados = inspeccionDao.getEstadosUnicos()
                
                // Ordenar estados por color (agrupar colores similares)
                val estadosOrdenados = estados.sortedWith { estado1, estado2 ->
                    val color1 = coloresEstados[estado1.uppercase().trim()] ?: 0
                    val color2 = coloresEstados[estado2.uppercase().trim()] ?: 0
                    color1.compareTo(color2)
                }
                
                Log.d("EstadoDropdown", "Estados ordenados: $estadosOrdenados")
                Log.d("EstadoDropdown", "Colores disponibles: $coloresEstados")
                
                // Crear adapter personalizado con colores
                val adapter = object : ArrayAdapter<String>(requireContext(), android.R.layout.simple_dropdown_item_1line, estadosOrdenados) {
                    override fun getView(position: Int, convertView: android.view.View?, parent: android.view.ViewGroup): android.view.View {
                        val view = super.getView(position, convertView, parent)
                        val estado = getItem(position)
                        if (estado != null) {
                            val color = coloresEstados[estado.uppercase().trim()]
                            if (color != null) {
                                view.setBackgroundColor(color)
                                (view as? android.widget.TextView)?.setTextColor(android.graphics.Color.BLACK)
                            }
                        }
                        return view
                    }
                    
                    override fun getDropDownView(position: Int, convertView: android.view.View?, parent: android.view.ViewGroup): android.view.View {
                        val view = super.getDropDownView(position, convertView, parent)
                        val estado = getItem(position)
                        if (estado != null) {
                            val color = coloresEstados[estado.uppercase().trim()]
                            if (color != null) {
                                view.setBackgroundColor(color)
                                (view as? android.widget.TextView)?.setTextColor(android.graphics.Color.BLACK)
                            }
                        }
                        return view
                    }
                }
                
                autoEstado.setAdapter(adapter)
                
                // Mostrar dropdown centrado con colores
                autoEstado.setOnClickListener {
                    val dialog = android.app.AlertDialog.Builder(requireContext())
                        .setTitle("Estado")
                        .setItems(estadosOrdenados.toTypedArray()) { d, which ->
                            val estadoSeleccionado = estadosOrdenados[which]
                            autoEstado.setText(estadoSeleccionado, false)
                            setEstadoBackground(estadoSeleccionado)
                            d.dismiss()
                        }
                        .setNegativeButton("Cancelar", null)
                        .create()
                    dialog.show()
                    
                    // Aplicar colores a los items del diálogo después de que se muestre
                    dialog.listView.post {
                        for (i in 0 until dialog.listView.count) {
                            val itemView = dialog.listView.getChildAt(i)
                            if (itemView != null) {
                                val estado = estadosOrdenados[i]
                                val color = coloresEstados[estado.uppercase().trim()]
                                Log.d("EstadoDropdown", "Estado: $estado, Color: $color")
                                if (color != null) {
                                    itemView.setBackgroundColor(color)
                                    (itemView as? android.widget.TextView)?.setTextColor(android.graphics.Color.BLACK)
                                }
                            }
                        }
                    }
                    
                    val window = dialog.window
                    window?.setLayout((resources.displayMetrics.widthPixels * 0.85).toInt(), android.view.WindowManager.LayoutParams.WRAP_CONTENT)
                    window?.setGravity(android.view.Gravity.CENTER)
                }
            } catch (e: Exception) {
                Log.e("EstadoDropdown", "Error al cargar estados: ${e.message}", e)
            }
        }
    }

    private fun actualizarInformacionInspector() {
        equipo?.let { equipo ->
            val fechaEstado = equipo.fechaInspeccion ?: ""
            val inspector = equipo.identidadInspector ?: ""
            val detector = equipo.detectorUtilizado ?: ""
            
            Log.d("FragmentInspeccionEquipo", "=== DEBUG DATOS INSPECTOR ===")
            Log.d("FragmentInspeccionEquipo", "fechaInspeccion: '$fechaEstado'")
            Log.d("FragmentInspeccionEquipo", "identidadInspector: '$inspector'")
            Log.d("FragmentInspeccionEquipo", "detectorUtilizado: '$detector'")
            Log.d("FragmentInspeccionEquipo", "Equipo ID: ${equipo.id}")
            
            val textoInspector = if (fechaEstado.isNotEmpty() && inspector.isNotEmpty()) {
                "$fechaEstado - $inspector ($detector)"
            } else {
                "Sin datos de inspección anterior"
            }
            
            labelDatosInspector.text = textoInspector
            
            // Actualizar modelo anterior
            val marca = equipo.marca ?: ""
            val modelo = equipo.modelo ?: ""
            val diametro = equipo.diametro ?: ""
            val conexion = equipo.conexion ?: ""
            
            val textoModelo = if (marca.isNotEmpty() && modelo.isNotEmpty()) {
                val diamConex = if (diametro.isNotEmpty() && conexion.isNotEmpty()) {
                    "($diametro-$conexion)"
                } else if (diametro.isNotEmpty()) {
                    "($diametro)"
                } else if (conexion.isNotEmpty()) {
                    "($conexion)"
                } else {
                    ""
                }
                "$marca - $modelo $diamConex"
            } else {
                ""
            }
            
            tvModeloAnterior.text = textoModelo
            
            Log.d("FragmentInspeccionEquipo", "Texto final inspector: '$textoInspector'")
            Log.d("FragmentInspeccionEquipo", "Texto final modelo: '$textoModelo'")
            Log.d("FragmentInspeccionEquipo", "=== FIN DEBUG ===")
        } ?: run {
            Log.e("FragmentInspeccionEquipo", "Equipo es null, no se puede actualizar información")
            labelDatosInspector.text = "Sin datos de inspección anterior"
            tvModeloAnterior.text = ""
        }
    }

    private fun guardarYAvanzar() {
        Log.d("FragmentInspeccionEquipo", "=== INICIO GUARDAR Y AVANZAR ===")
        
        equipo?.let { equipoActual ->
            // Obtener datos actuales del usuario logueado
            val fechaActual = obtenerFechaActual()
            val inspectorActual = obtenerInspectorActual()
            val detectorActual = obtenerDetectorActual()
            
            Log.d("FragmentInspeccionEquipo", "Datos del usuario actual:")
            Log.d("FragmentInspeccionEquipo", "  - Fecha: $fechaActual")
            Log.d("FragmentInspeccionEquipo", "  - Inspector: $inspectorActual")
            Log.d("FragmentInspeccionEquipo", "  - Detector: $detectorActual")
            
            // Obtener coordenadas GPS actuales al momento de guardar
            val lastLocation = com.bithermmanagement.ui.MainMenuActivity.GpsProvider.lastLocation
            val coordenadasGPS = if (lastLocation != null) {
                "${lastLocation.latitude}, ${lastLocation.longitude}"
            } else {
                equipoActual.gpsCoord ?: ""
            }
            
            val precisionGPS = if (lastLocation != null) {
                "${"%.1f".format(lastLocation.accuracy)}m"
            } else {
                equipoActual.gpsAcc ?: ""
            }
            
            Log.d("FragmentInspeccionEquipo", "GPS actual:")
            Log.d("FragmentInspeccionEquipo", "  - Coordenadas: $coordenadasGPS")
            Log.d("FragmentInspeccionEquipo", "  - Precisión: $precisionGPS")
            
            // Obtener datos de los campos
            val estado = autoEstado.text.toString()
            val ubicacion = etUbicacion.text.toString()
            val nota = etNota.text.toString()
            val incidencias = etIncidencias.text.toString()
            val linea = etLinea.text.toString()
            
            Log.d("FragmentInspeccionEquipo", "Datos de los campos:")
            Log.d("FragmentInspeccionEquipo", "  - Estado: $estado")
            Log.d("FragmentInspeccionEquipo", "  - Ubicación: $ubicacion")
            Log.d("FragmentInspeccionEquipo", "  - Nota: $nota")
            Log.d("FragmentInspeccionEquipo", "  - Incidencias: $incidencias")
            Log.d("FragmentInspeccionEquipo", "  - Línea: $linea")
            
            // Crear equipo actualizado con los nuevos datos
            val equipoActualizado = equipoActual.copy(
                fechaInspeccion = fechaActual,
                identidadInspector = inspectorActual,
                detectorUtilizado = detectorActual,
                estado = estado,
                ubicacion = ubicacion,
                nota = nota,
                incidencias = incidencias,
                linea = linea,
                gpsCoord = coordenadasGPS,
                gpsAcc = precisionGPS,
                modificadoLocal = true
            )
            
            Log.d("FragmentInspeccionEquipo", "Equipo actualizado creado:")
            Log.d("FragmentInspeccionEquipo", "  - ID: ${equipoActualizado.id}")
            Log.d("FragmentInspeccionEquipo", "  - Fecha inspección: ${equipoActualizado.fechaInspeccion}")
            Log.d("FragmentInspeccionEquipo", "  - Inspector: ${equipoActualizado.identidadInspector}")
            Log.d("FragmentInspeccionEquipo", "  - Detector: ${equipoActualizado.detectorUtilizado}")
            
            // Guardar en la base de datos
            lifecycleScope.launch {
                try {
                    inspeccionDao.actualizarEquipo(equipoActualizado)
                    Log.d("FragmentInspeccionEquipo", "✅ Equipo actualizado exitosamente en BD: ${equipoActualizado.id}")
                    
                    // Actualizar el equipo local
                    equipo = equipoActualizado
                    listaEquipos[indiceActual] = equipoActualizado
                    
                    // Actualizar la información del inspector en la UI
                    actualizarInformacionInspector()
                    
                    Log.d("FragmentInspeccionEquipo", "✅ Datos guardados correctamente, navegando al siguiente...")
                    
                    // Navegar al siguiente purgador
                    navegarPurgador(1)
                    
                } catch (e: Exception) {
                    Log.e("FragmentInspeccionEquipo", "❌ Error guardando equipo: ${e.message}", e)
                    // Mostrar error al usuario
                    mostrarError("Error al guardar: ${e.message}")
                }
            }
        } ?: run {
            Log.e("FragmentInspeccionEquipo", "❌ Equipo es null, no se puede guardar")
            mostrarError("No hay equipo seleccionado para guardar")
        }
        
        Log.d("FragmentInspeccionEquipo", "=== FIN GUARDAR Y AVANZAR ===")
    }

    private fun obtenerFechaActual(): String {
        val sdf = java.text.SimpleDateFormat("dd/MM/yyyy", java.util.Locale.getDefault())
        return sdf.format(java.util.Date())
    }

    private fun obtenerInspectorActual(): String {
        // Obtener del SharedPreferences
        val prefs = requireContext().getSharedPreferences("bitherm_prefs", android.content.Context.MODE_PRIVATE)
        val swWeb = prefs.getString("sw_web", "SW WEB") ?: "SW WEB"
        Log.d("FragmentInspeccionEquipo", "Inspector actual obtenido: $swWeb")
        return swWeb
    }

    private fun obtenerDetectorActual(): String {
        // Obtener del SharedPreferences
        val prefs = requireContext().getSharedPreferences("bitherm_prefs", android.content.Context.MODE_PRIVATE)
        val equipoAsignado = prefs.getString("equipo_asignado", "Detector") ?: "Detector"
        Log.d("FragmentInspeccionEquipo", "Detector actual obtenido: $equipoAsignado")
        return equipoAsignado
    }

    private fun mostrarError(mensaje: String) {
        android.app.AlertDialog.Builder(requireContext())
            .setTitle("Error")
            .setMessage(mensaje)
            .setPositiveButton("OK", null)
            .show()
    }
} 