<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Aquí puedes dejar otros estilos válidos si los hay, pero elimina los relacionados con ShapeAppearanceOverlay.MaterialComponents -->

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/bitherm_blue</item>
        <item name="colorPrimaryDark">@color/bitherm_blue</item>
        <item name="colorAccent">@color/bitherm_blue</item>
    </style>

    <style name="ToolbarStyle" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
        <item name="android:contentInsetStart">0dp</item>
        <item name="contentInsetStart">0dp</item>
        <item name="android:contentInsetLeft">0dp</item>
        <item name="contentInsetLeft">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:background">@color/bitherm_blue</item>
    </style>

    <style name="NavigationIconStyle" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="SpinnerTextBlack" parent="Theme.AppCompat.Light">
        <item name="android:textColor">@color/bitherm_blue</item>
        <item name="android:colorControlNormal">@color/bitherm_blue</item>
        <item name="android:colorControlActivated">@color/bitherm_blue</item>
        <item name="android:colorAccent">@color/bitherm_blue</item>
    </style>

    <style name="CardTextBlack" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@android:color/black</item>
    </style>
    <style name="CardEditTextBlack" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
</resources> 