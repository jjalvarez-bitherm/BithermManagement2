@AndroidEntryPoint
class FragmentInspeccionEquipo : Fragment() {

    @Inject
    lateinit var inspeccionDao: InspeccionDao

    private lateinit var fusedLocationClient: FusedLocationProviderClient
    private var equipo: Equipo? = null

    // Views
    private lateinit var spinnerArea: MaterialAutoCompleteTextView
    private lateinit var spinnerUnidad: MaterialAutoCompleteTextView
    private lateinit var spinnerMarca: MaterialAutoCompleteTextView
    private lateinit var spinnerModelo: MaterialAutoCompleteTextView
    private lateinit var spinnerTipo: MaterialAutoCompleteTextView
    private lateinit var spinnerDiametro: MaterialAutoCompleteTextView
    private lateinit var spinnerConexion: MaterialAutoCompleteTextView
    private lateinit var spinnerInstalacion: MaterialAutoCompleteTextView
    private lateinit var spinnerAislamiento: MaterialAutoCompleteTextView
    private lateinit var spinnerPresEntrada: MaterialAutoCompleteTextView
    private lateinit var spinnerPresSalida: MaterialAutoCompleteTextView
    private lateinit var spinnerDescarga: MaterialAutoCompleteTextView
    private lateinit var spinnerAplicacion: MaterialAutoCompleteTextView
    private lateinit var spinnerServicio: MaterialAutoCompleteTextView
    private lateinit var etUbicacion: TextInputEditText
    private lateinit var tvGPS: TextView
    private lateinit var btnActualizarGPS: ImageButton
    private lateinit var btnNavegar: ImageButton
    private lateinit var etNota: TextInputEditText
    private lateinit var etIncidencias: TextInputEditText
    private lateinit var etLinea: TextInputEditText
    private lateinit var viewPagerImagenes: androidx.viewpager2.widget.ViewPager2
    private lateinit var indicadorPaginas: LinearLayout
    private lateinit var tvIdEquipo: TextView
    private lateinit var autoEstado: MaterialAutoCompleteTextView
    private lateinit var labelDatosInspector: TextView
    private lateinit var tvModeloAnterior: TextView

    private var gpsRequestInProgress = false
    private var gpsTimeoutHandler: Handler? = null
    private var gpsTimeoutRunnable: Runnable? = null
    private var gpsDialog: AlertDialog? = null
    private var gpsDialogView: View? = null
    private var gpsLocationCallback: com.google.android.gms.location.LocationCallback? = null
    private var gpsLocationRequest: com.google.android.gms.location.LocationRequest? = null
    private var gpsBestLocation: android.location.Location? = null
    private var gpsBestPrecision: Float = Float.MAX_VALUE
    private var gpsMaxWaitMillis: Long = 5000
    private var gpsStartTime: Long = 0L
    private var coloresEstados: Map<String, Int> = emptyMap()

    private val valoresInstalacionPorDefecto = listOf("MANIFOLD VAPOR", "MANIFOLD CONDENSADO", "EN LINEA", "PIANILLO")
    private val valoresAislamientoPorDefecto = listOf("V/V ANTEIOR Y POST", "V/V ANTERIOR", "TVS", "SIN AISLAMIENTO")

    // Variables para la navegación de purgadores
    private var listaEquipos: List<Equipo> = emptyList()
    private var indiceActual: Int = 0

    companion object {
        private const val LOCATION_PERMISSION_REQUEST_CODE = 1001
        private const val ARG_LISTA_EQUIPOS = "ARG_LISTA_EQUIPOS"
        private const val ARG_INDICE_ACTUAL = "ARG_INDICE_ACTUAL"
        fun newInstance(lista: List<Equipo>, indice: Int): FragmentInspeccionEquipo {
            val fragment = FragmentInspeccionEquipo()
            val args = Bundle()
            args.putSerializable(ARG_LISTA_EQUIPOS, ArrayList(lista))
            args.putInt(ARG_INDICE_ACTUAL, indice)
            fragment.arguments = args
            Log.d("FragmentInspeccionEquipo", "newInstance: Recibida lista de ${lista.size} equipos, índice inicial: $indice")
            Log.d("FragmentInspeccionEquipo", "DEBUG: Primeros 3 IDs de la lista: ${lista.take(3).map { it.id }}")
            return fragment
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        arguments?.let { args ->
            @Suppress("UNCHECKED_CAST")
            listaEquipos = (args.getSerializable(ARG_LISTA_EQUIPOS) as? ArrayList<Equipo>) ?: emptyList()
            indiceActual = args.getInt(ARG_INDICE_ACTUAL, 0)
            equipo = if (listaEquipos.isNotEmpty() && indiceActual in listaEquipos.indices) listaEquipos[indiceActual] else null
            Log.d("FragmentInspeccionEquipo", "onCreate: Lista recibida con ${listaEquipos.size} equipos, índice actual: $indiceActual")
            Log.d("FragmentInspeccionEquipo", "DEBUG: listaEquipos IDs: ${listaEquipos.take(5).map { it.id }}")
            Log.d("FragmentInspeccionEquipo", "DEBUG: equipo seleccionado: ${equipo?.id}")
        }
    }

    override fun onCreateView(
        inflater: LayoutInflater,
        container: ViewGroup?,
        savedInstanceState: Bundle?
    ): View? {
        Log.d("FragmentInspeccionEquipo", "onCreateView")
        return inflater.inflate(R.layout.fragment_detalle_equipo, container, false)
    }

    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
        super.onViewCreated(view, savedInstanceState)
        Log.d("FragmentInspeccionEquipo", "onViewCreated")
        fusedLocationClient = LocationServices.getFusedLocationProviderClient(requireActivity())
        initializeViews(view)
        setupSpinners()
        setupEstadoDropdown()
        setupGPS()
        setupCarruselImagenes()
        cargarDatosEquipo()
        coloresEstados = cargarColoresEstados()

        etUbicacion.textSize = etUbicacion.textSize / resources.displayMetrics.scaledDensity + 2f

        // Asignar listeners a los botones de navegación
        view.findViewById<View>(R.id.navAnteriorBlock)?.setOnClickListener {
            Log.d("NavegacionPurgador", "Flecha ANTERIOR pulsada. Índice actual: $indiceActual")
            navegarPurgador(-1)
        }
        view.findViewById<View>(R.id.navSiguienteBlock)?.setOnClickListener {
            Log.d("NavegacionPurgador", "Flecha SIGUIENTE pulsada. Índice actual: $indiceActual")
            navegarPurgador(1)
        }

        // Botón Guardar y Siguiente
        view.findViewById<android.widget.Button>(R.id.btnGuardar)?.setOnClickListener {
            Log.d("FragmentInspeccionEquipo", "Botón GUARDAR Y SIGUIENTE pulsado")
            guardarYAvanzar()
        }

        btnNavegar.setOnClickListener {
            Log.d("FragmentInspeccionEquipo", "CLICK en btnNavegar - iniciando navegación GPS")
            val regex = Regex("(-?\\d+\\.\\d+),\\s*(-?\\d+\\.\\d+)")
            val match = regex.find(tvGPS.text.toString())
            if (match != null) {
                val latDestino = match.groupValues[1]
                val lonDestino = match.groupValues[2]
                Log.d("FragmentInspeccionEquipo", "NAVEGANDO a Google Maps: lat=$latDestino, lon=$lonDestino")
                val gmmIntentUri = android.net.Uri.parse("google.navigation:q=$latDestino,$lonDestino&mode=w")
                val mapIntent = android.content.Intent(android.content.Intent.ACTION_VIEW, gmmIntentUri)
                mapIntent.setPackage("com.google.android.apps.maps")
                if (mapIntent.resolveActivity(requireContext().packageManager) != null) {
                    startActivity(mapIntent)
                } else {
                    android.widget.Toast.makeText(requireContext(), "Google Maps no está instalado", android.widget.Toast.LENGTH_SHORT).show()
                }
            } else {
                android.widget.Toast.makeText(requireContext(), "No se pudieron extraer las coordenadas destino", android.widget.Toast.LENGTH_SHORT).show()
            }
        }

        // Escuchar cambios de foto principal desde el visor
        parentFragmentManager.setFragmentResultListener("foto_principal_actualizada", viewLifecycleOwner) { _, bundle ->
            val nuevaRuta = bundle.getString("ruta_foto")
            Log.d("FragmentInspeccionEquipo", "Recibido setFragmentResultListener con ruta: $nuevaRuta")
            if (!nuevaRuta.isNullOrBlank()) {
                val existe = java.io.File(nuevaRuta).exists()
                Log.d("FragmentInspeccionEquipo", "¿Existe el archivo? $existe")
                if (existe) {
                    Log.d("FragmentInspeccionEquipo", "Imagen cargada en carrusel")
                    cargarCarruselImagenes()
                } else {
                    Log.e("FragmentInspeccionEquipo", "El archivo de la foto principal no existe: $nuevaRuta")
                }
            } else {
                Log.e("FragmentInspeccionEquipo", "Ruta de foto principal vacía o nula")
            }
        }
    }

    private fun initializeViews(view: View) {
        Log.d("FragmentInspeccionEquipo", "Inicializando views")
        spinnerArea = view.findViewById(R.id.spinnerArea)
        spinnerUnidad = view.findViewById(R.id.spinnerUnidad)
        spinnerMarca = view.findViewById(R.id.spinnerMarca)
        spinnerModelo = view.findViewById(R.id.spinnerModelo)
        spinnerTipo = view.findViewById(R.id.spinnerTipo)
        spinnerDiametro = view.findViewById(R.id.spinnerDiametro)
        spinnerConexion = view.findViewById(R.id.spinnerConexion)
        spinnerInstalacion = view.findViewById(R.id.spinnerInstalacion)
        spinnerAislamiento = view.findViewById(R.id.spinnerAislamiento)
        spinnerPresEntrada = view.findViewById(R.id.spinnerPresEntrada)
        spinnerPresSalida = view.findViewById(R.id.spinnerPresSalida)
        spinnerDescarga = view.findViewById(R.id.spinnerDescarga)
        spinnerAplicacion = view.findViewById(R.id.spinnerAplicacion)
        spinnerServicio = view.findViewById(R.id.spinnerServicio)
        etUbicacion = view.findViewById(R.id.etUbicacion)
        tvGPS = view.findViewById(R.id.tvGPS)
        btnActualizarGPS = view.findViewById(R.id.btnActualizarGPS)
        btnNavegar = view.findViewById(R.id.btnNavegar)
        etNota = view.findViewById(R.id.etNota)
        etIncidencias = view.findViewById(R.id.etIncidencias)
        etLinea = view.findViewById(R.id.etLinea)
        tvIdEquipo = view.findViewById(R.id.tvIdEquipo)
        autoEstado = view.findViewById(R.id.autoEstado)
        labelDatosInspector = view.findViewById(R.id.labelDatosInspector)
        tvModeloAnterior = view.findViewById(R.id.tvModeloAnterior)
        autoEstado.setText("HOLA", false)

        // Hacer todos los dropdowns solo seleccionables (no editables), excepto aislamiento
        val dropdowns = listOf(
            spinnerArea, spinnerUnidad, spinnerMarca, spinnerModelo, spinnerTipo, spinnerDiametro,
            spinnerConexion, spinnerInstalacion, spinnerPresEntrada, spinnerPresSalida, spinnerDescarga, spinnerAplicacion, spinnerServicio
        )
        dropdowns.forEach {
            it.setKeyListener(null)
            it.isCursorVisible = false
            it.isFocusable = false
            it.isFocusableInTouchMode = false
            it.setOnClickListener { v -> (v as? com.google.android.material.textfield.MaterialAutoCompleteTextView)?.showDropDown() }
        }
        // El de aislamiento sí permite texto libre
        spinnerAislamiento.isFocusable = true
        spinnerAislamiento.isFocusableInTouchMode = true
        spinnerAislamiento.isCursorVisible = true
        spinnerAislamiento.setKeyListener(android.text.method.TextKeyListener.getInstance())
    }

    private fun cargarDatosEquipo() {
        Log.d("EquipoDebug", "Cargando datos del equipo: $equipo")
        equipo?.let { equipo ->
            Log.d("EquipoDebug", "Campos del equipo: id=${equipo.id}, area=${equipo.area}, unidad=${equipo.unidad}, ubicacion=${equipo.ubicacion}, gps=${equipo.gpsCoord}, instalacion=${equipo.instalacion}, linea=${equipo.linea}, estado=${equipo.estado}, marca=${equipo.marca}, modelo=${equipo.modelo}, tipo=${equipo.tipo}, diametro=${equipo.diametro}, conexion=${equipo.conexion}, aislamiento=${equipo.aislamiento}, presEntrada=${equipo.presEntrada}, presSalida=${equipo.presSalida}, descarga=${equipo.descarga}, aplicacion=${equipo.aplicacion}, servicio=${equipo.servicio}, nota=${equipo.nota}, incidencias=${equipo.incidencias}")
            tvIdEquipo.text = equipo.id ?: ""
            tvIdEquipo.setTypeface(null, android.graphics.Typeface.BOLD)
            val estado = equipo.estado ?: ""
            autoEstado.setText(estado, false)
            autoEstado.post {
                setEstadoBackground(estado)
            }
            autoEstado.textSize = 21f // 16sp + 5pt aprox
            spinnerArea.setText(equipo.area ?: "", false)
            spinnerUnidad.setText(equipo.unidad ?: "", false)
            spinnerMarca.setText(equipo.marca ?: "", false)
            spinnerModelo.setText(equipo.modelo ?: "", false)
            spinnerTipo.setText(equipo.tipo ?: "", false)
            spinnerDiametro.setText(equipo.diametro ?: "", false)
            spinnerConexion.setText(equipo.conexion ?: "", false)
            spinnerInstalacion.setText(equipo.instalacion ?: "", false)
            spinnerAislamiento.setText(equipo.aislamiento ?: "", false)
            spinnerPresEntrada.setText(equipo.presEntrada ?: "", false)
            spinnerPresSalida.setText(equipo.presSalida ?: "", false)
            spinnerDescarga.setText(equipo.descarga ?: "", false)
            spinnerAplicacion.setText(equipo.aplicacion ?: "", false)
            spinnerServicio.setText(equipo.servicio ?: "", false)
            etUbicacion.setText(equipo.ubicacion ?: "")
            etNota.setText(equipo.nota ?: "")
            etIncidencias.setText(equipo.incidencias ?: "")
            etLinea.setText(equipo.linea ?: "")
            // Cargar GPS con formato correcto
            val gpsCoord = equipo.gpsCoord ?: ""
            val gpsAcc = equipo.gpsAcc ?: ""
            
            if (gpsCoord.isNotEmpty() && gpsAcc.isNotEmpty()) {
                val accParts = gpsAcc.split(", ")
                if (accParts.size >= 1) {
                    val precision = accParts[0]
                    tvGPS.text = "GPS: $gpsCoord (±$precision)"
                } else {
                    tvGPS.text = "GPS: $gpsCoord"
                }
            } else if (gpsCoord.isNotEmpty()) {
                tvGPS.text = "GPS: $gpsCoord"
            } else {
                tvGPS.text = ""
            }
            // Cargar carrusel de imágenes
            cargarCarruselImagenes()
            
            // Actualizar información del inspector
            actualizarInformacionInspector()
        }
    }

    private fun setEstadoBackground(estado: String) {
        val color = coloresEstados[estado.uppercase().trim()] ?: resources.getColor(R.color.gray_light, null)
        autoEstado.setTextColor(android.graphics.Color.BLACK)
        autoEstado.setHintTextColor(android.graphics.Color.BLACK)
        // Crear fondo dinámico con borde y esquinas redondeadas
        val drawable = GradientDrawable().apply {
            shape = GradientDrawable.RECTANGLE
            cornerRadius = 24f
            setColor(color)
            setStroke(4, android.graphics.Color.DKGRAY)
        }
        autoEstado.background = drawable
    }

    private fun setupSpinners() {
        Log.d("FragmentInspeccionEquipo", "Configurando spinners (inicio)")
        lifecycleScope.launch {
            try {
                Log.d("SpinnerDebug", "Antes de obtener áreas")
                val areas = inspeccionDao.getAreasUnicas()
                spinnerArea.setOnClickListener {
                    showCenteredDropdown("Área", areas) { seleccion ->
                        spinnerArea.setText(seleccion, false)
                        actualizarUnidadesPorArea(seleccion)
                        // Abrir automáticamente el dropdown de unidad tras actualizar
                        spinnerUnidad.post { spinnerUnidad.showDropDown() }
                    }
                }
                // UNIDAD: se actualiza al seleccionar área
                spinnerUnidad.setOnClickListener {
                    val area = spinnerArea.text.toString()
                    actualizarUnidadesPorArea(area)
                }
                // INSTALACIÓN: valores de BD o por defecto
                spinnerInstalacion.setOnClickListener {
                    lifecycleScope.launch {
                        val instalaciones = inspeccionDao.getInstalacionesUnicas().ifEmpty { valoresInstalacionPorDefecto }
                        showCenteredDropdown("Instalación", instalaciones) { seleccion ->
                            spinnerInstalacion.setText(seleccion, false)
                        }
                    }
                }
                // AISLAMIENTO: valores de BD + por defecto + texto libre
                spinnerAislamiento.setOnClickListener {
                    lifecycleScope.launch {
                        val aislamientosBD = inspeccionDao.getAislamientosUnicos()
                        val aislamientos = (aislamientosBD + valoresAislamientoPorDefecto).distinct()
                        showCenteredDropdown("Aislamiento", aislamientos) { seleccion ->
                            spinnerAislamiento.setText(seleccion, false)
                        }
                    }
                }
            } catch (e: Exception) {
                Log.e("SpinnerDebug", "Error en setupSpinners: ${e.message}", e)
            }
        }
        spinnerMarca.setOnClickListener {
            lifecycleScope.launch {
                val marcas = inspeccionDao.getMarcasUnicas()
                showCenteredDropdown("Marca", marcas) { seleccion ->
                    spinnerMarca.setText(seleccion, false)
                    actualizarModelosPorMarca(seleccion)
                    // Abrir automáticamente el dropdown de modelo tras actualizar
                    spinnerModelo.post { spinnerModelo.showDropDown() }
                }
            }
        }
        spinnerModelo.setOnClickListener {
            val marca = spinnerMarca.text.toString()
            lifecycleScope.launch {
                val modelos = inspeccionDao.getModelosUnicosPorMarcas(listOf(marca))
                showCenteredDropdown("Modelo", modelos) { seleccion ->
                    spinnerModelo.setText(seleccion, false)
                    // Actualizar tipos por marca y modelo seleccionado
                    actualizarTiposPorMarcaModelo(marca, seleccion)
                    // Abrir automáticamente el dropdown de tipo tras actualizar
                    spinnerTipo.post { spinnerTipo.showDropDown() }
                }
            }
        }
        spinnerTipo.setOnClickListener {
            val marca = spinnerMarca.text.toString()
            val modelo = spinnerModelo.text.toString()
            lifecycleScope.launch {
                val tipos = if (marca.isNotEmpty() && modelo.isNotEmpty()) {
                    inspeccionDao.getTiposUnicosPorMarcaModelo(marca, modelo)
                } else {
                    inspeccionDao.getTiposUnicos()
                }
                showCenteredDropdown("Tipo", tipos) { seleccion ->
                    spinnerTipo.setText(seleccion, false)
                }
            }
        }
        spinnerDiametro.setOnClickListener {
            lifecycleScope.launch {
                val diametros = inspeccionDao.getDiametrosUnicos()
                showCenteredDropdown("Diámetro", diametros) { seleccion ->
                    spinnerDiametro.setText(seleccion, false)
                }
            }
        }
        spinnerConexion.setOnClickListener {
            lifecycleScope.launch {
                val conexiones = inspeccionDao.getConexionesUnicas()
                showCenteredDropdown("Conexión", conexiones) { seleccion ->
                    spinnerConexion.setText(seleccion, false)
                }
            }
        }
        spinnerPresEntrada.setOnClickListener {
            lifecycleScope.launch {
                val presiones = inspeccionDao.getPresionesEntradaUnicas()
                showCenteredDropdown("Pres. Entrada", presiones) { seleccion ->
                    spinnerPresEntrada.setText(seleccion, false)
                    // Actualizar presiones de salida por entrada seleccionada
                    actualizarPresionesSalidaPorEntrada(seleccion)
                }
            }
        }
        spinnerPresSalida.setOnClickListener {
            val presionEntrada = spinnerPresEntrada.text.toString()
            lifecycleScope.launch {
                val presiones = if (presionEntrada.isNotEmpty()) {
                    inspeccionDao.getPresionesSalidaMenoresQue(presionEntrada)
                } else {
                    inspeccionDao.getPresionesSalidaUnicas()
                }
                showCenteredDropdown("Pres. Salida", presiones) { seleccion ->
                    spinnerPresSalida.setText(seleccion, false)
                }
            }
        }
        spinnerDescarga.setOnClickListener {
            lifecycleScope.launch {
                val descargas = inspeccionDao.getDescargasUnicas()
                showCenteredDropdown("Descarga", descargas) { seleccion ->
                    spinnerDescarga.setText(seleccion, false)
                }
            }
        }
        spinnerAplicacion.setOnClickListener {
            lifecycleScope.launch {
                val aplicaciones = inspeccionDao.getAplicacionesUnicas()
                showCenteredDropdown("Aplicación", aplicaciones) { seleccion ->
                    spinnerAplicacion.setText(seleccion, false)
                }
            }
        }
        spinnerServicio.setOnClickListener {
            lifecycleScope.launch {
                val servicios = inspeccionDao.getServiciosUnicos()
                showCenteredDropdown("Servicio", servicios) { seleccion ->
                    spinnerServicio.setText(seleccion, false)
                }
            }
        }
    }

    private fun actualizarUnidadesPorArea(area: String) {
        lifecycleScope.launch {
            val unidades = inspeccionDao.getUnidadesPorArea(area)
            val adapter = ArrayAdapter(requireContext(), android.R.layout.simple_dropdown_item_1line, unidades)
            spinnerUnidad.setAdapter(adapter)
            showCenteredDropdown("Unidad", unidades) { seleccion ->
                spinnerUnidad.setText(seleccion, false)
            }
        }
    }

    private fun setupGPS() {
        Log.d("FragmentInspeccionEquipo", "Configurando GPS")
        btnActualizarGPS.setOnClickListener {
            Log.d("FragmentInspeccionEquipo", "Obteniendo coordenadas del GPS en segundo plano")
            
            // Obtener la última ubicación del GPS en segundo plano
            val lastLocation = com.bithermmanagement.ui.MainMenuActivity.GpsProvider.lastLocation
            
            if (lastLocation != null) {
                val precision = lastLocation.accuracy
                val coordinates = "${lastLocation.latitude}, ${lastLocation.longitude}"
                
                Log.d("FragmentInspeccionEquipo", "GPS obtenido: $coordinates, precisión: ${"%.1f".format(precision)}m")
                
                // Actualizar la UI con formato unificado
                tvGPS.text = "GPS: ${"%.6f".format(lastLocation.latitude)}, ${"%.6f".format(lastLocation.longitude)} (±${"%.1f".format(precision)}m)"
                etUbicacion.setText(coordinates)
                
                android.widget.Toast.makeText(
                    requireContext(), 
                    "Coordenadas actualizadas: $coordinates", 
                    android.widget.Toast.LENGTH_SHORT
                ).show()
            } else {
                Log.d("FragmentInspeccionEquipo", "No hay ubicación GPS disponible, iniciando captura manual")
                android.widget.Toast.makeText(
                    requireContext(), 
                    "No hay GPS disponible, iniciando captura manual...", 
                    android.widget.Toast.LENGTH_SHORT
                ).show()
                
                if (!gpsRequestInProgress) {
                    mostrarDialogoGPS()
                }
            }
        }
    }

    private fun mostrarDialogoGPS() {
        gpsRequestInProgress = true
        gpsMaxWaitMillis = 5000
        gpsBestLocation = null
        gpsBestPrecision = Float.MAX_VALUE
        gpsStartTime = System.currentTimeMillis()
        val builder = AlertDialog.Builder(requireContext())
        builder.setTitle("Captura de GPS")
        val dialogView = layoutInflater.inflate(R.layout.dialog_gps_capture, null)
        gpsDialogView = dialogView
        val tvEstado = dialogView.findViewById<TextView>(R.id.tvEstadoGPS)
        val tvPrecision = dialogView.findViewById<TextView>(R.id.tvPrecisionGPS)
        tvEstado.text = "Obteniendo ubicación..."
        tvPrecision.text = "Precisión: -- m"
        builder.setView(dialogView)
        builder.setCancelable(false)
        builder.setPositiveButton("Aceptar esta precisión", null)
        builder.setNeutralButton("Esperar más", null)
        builder.setNegativeButton("Cancelar") { _, _ -> cancelarCapturaGPS() }
        gpsDialog = builder.create()
        gpsDialog?.setOnShowListener {
            gpsDialog?.getButton(AlertDialog.BUTTON_POSITIVE)?.isEnabled = false
            gpsDialog?.getButton(AlertDialog.BUTTON_NEUTRAL)?.isEnabled = false
        }
        gpsDialog?.show()
        iniciarCapturaGPS(tvEstado, tvPrecision)
    }

    private fun iniciarCapturaGPS(tvEstado: TextView, tvPrecision: TextView) {
        val fusedLocationProvider = fusedLocationClient
        gpsLocationRequest = com.google.android.gms.location.LocationRequest.create().apply {
            interval = 1000
            fastestInterval = 500
            priority = com.google.android.gms.location.LocationRequest.PRIORITY_HIGH_ACCURACY
            numUpdates = 20
        }
        gpsLocationCallback = object : com.google.android.gms.location.LocationCallback() {
            override fun onLocationResult(result: com.google.android.gms.location.LocationResult) {
                Log.d("GPS", "onLocationResult llamado")
                val location = result.lastLocation
                if (location != null) {
                    val precision = location.accuracy
                    Log.d("GPS", "Lat: ${location.latitude}, Lon: ${location.longitude}, Precisión: $precision")
                    tvEstado.text = "Ubicación recibida"
                    tvPrecision.text = "Precisión: ${"%.1f".format(precision)} m"
                    if (precision < gpsBestPrecision) {
                        gpsBestPrecision = precision
                        gpsBestLocation = location
                    }
                    val elapsed = System.currentTimeMillis() - gpsStartTime
                    if (gpsBestPrecision <= 10f) {
                        finalizarDialogoGPS(true)
                        fusedLocationProvider.removeLocationUpdates(this)
                    } else if (elapsed >= 20000) { // 20 segundos
                        Log.d("GPS", "Timeout alcanzado (20s)")
                        finalizarDialogoGPS(false)
                        fusedLocationProvider.removeLocationUpdates(this)
                    }
                } else {
                    Log.d("GPS", "Location es null")
                }
            }
            override fun onLocationAvailability(availability: com.google.android.gms.location.LocationAvailability) {
                Log.d("GPS", "onLocationAvailability: ${availability.isLocationAvailable}")
            }
        }
        if (checkLocationPermission()) {
            fusedLocationProvider.requestLocationUpdates(gpsLocationRequest!!, gpsLocationCallback!!, null)
        }
        // Handler para timeout manual
        gpsTimeoutHandler = android.os.Handler()
        gpsTimeoutRunnable = Runnable {
            if (gpsRequestInProgress) {
                Log.d("GPS", "Timeout handler (20s)")
                finalizarDialogoGPS(false)
                fusedLocationProvider.removeLocationUpdates(gpsLocationCallback!!)
            }
        }
        gpsTimeoutHandler?.postDelayed(gpsTimeoutRunnable!!, 20000)
    }

    private fun finalizarDialogoGPS(precisionOk: Boolean) {
        gpsRequestInProgress = false
        gpsTimeoutHandler?.removeCallbacks(gpsTimeoutRunnable!!)
        val tvEstado = gpsDialogView?.findViewById<TextView>(R.id.tvEstadoGPS)
        val tvPrecision = gpsDialogView?.findViewById<TextView>(R.id.tvPrecisionGPS)
        val precision = gpsBestPrecision
        val location = gpsBestLocation
        val btnPositivo = gpsDialog?.getButton(AlertDialog.BUTTON_POSITIVE)
        val btnNeutral = gpsDialog?.getButton(AlertDialog.BUTTON_NEUTRAL)
        val btnNegativo = gpsDialog?.getButton(AlertDialog.BUTTON_NEGATIVE)
        if (location == null) {
            tvEstado?.text = "No se pudo obtener ubicación."
            tvPrecision?.text = "Precisión: -- m"
            btnPositivo?.isEnabled = false
            btnNeutral?.isEnabled = false
            btnNegativo?.isEnabled = true
            return
        }
        tvEstado?.text = "Precisión obtenida: ${"%.1f".format(precision)} m"
        tvPrecision?.text = "Coordenadas: ${location.latitude}, ${location.longitude}"
        btnNegativo?.setOnClickListener { cancelarCapturaGPS() }
        if (precision <= 10f) {
            btnPositivo?.text = "Asignar"
            btnPositivo?.isEnabled = true
            btnNeutral?.isEnabled = false
            btnPositivo?.setOnClickListener {
                tvGPS.text = "GPS: ${"%.6f".format(location.latitude)}, ${"%.6f".format(location.longitude)} (±${"%.1f".format(precision)}m)"
                etUbicacion.setText("${location.latitude}, ${location.longitude}")
                gpsDialog?.dismiss()
            }
        } else {
            btnPositivo?.text = "Aceptar esta precisión"
            btnPositivo?.isEnabled = true
            btnNeutral?.isEnabled = true
            btnPositivo?.setOnClickListener {
                tvGPS.text = "GPS: ${"%.6f".format(location.latitude)}, ${"%.6f".format(location.longitude)} (±${"%.1f".format(precision)}m)"
                etUbicacion.setText("${location.latitude}, ${location.longitude}")
                gpsDialog?.dismiss()
            }
            btnNeutral?.setOnClickListener {
                gpsDialog?.dismiss()
                mostrarDialogoGPS()
            }
        }
    }

    private fun cancelarCapturaGPS() {
        gpsRequestInProgress = false
        gpsTimeoutHandler?.removeCallbacks(gpsTimeoutRunnable!!)
        gpsDialog?.dismiss()
        val fusedLocationProvider = fusedLocationClient
        gpsLocationCallback?.let { fusedLocationProvider.removeLocationUpdates(it) }
    }

    private fun checkLocationPermission(): Boolean {
        return if (ActivityCompat.checkSelfPermission(
                requireContext(),
                Manifest.permission.ACCESS_FINE_LOCATION
            ) != PackageManager.PERMISSION_GRANTED
        ) {
            requestPermissions(
                arrayOf(Manifest.permission.ACCESS_FINE_LOCATION),
                LOCATION_PERMISSION_REQUEST_CODE
            )
            false
        } else {
            true
        }
    }

    override fun onRequestPermissionsResult(
        requestCode: Int,
        permissions: Array<out String>,
        grantResults: IntArray
    ) {
        when (requestCode) {
            LOCATION_PERMISSION_REQUEST_CODE -> {
                if (grantResults.isNotEmpty() && grantResults[0] == PackageManager.PERMISSION_GRANTED) {
                    mostrarDialogoGPS()
                }
            }
        }
    }

    private fun setupCarruselImagenes() {
        // Configurar ViewPager2
        viewPagerImagenes = requireView().findViewById(R.id.viewPagerImagenes)
        indicadorPaginas = requireView().findViewById(R.id.indicadorPaginas)
        
        // Configurar el carrusel cuando se carguen los datos del equipo
        cargarCarruselImagenes()
    }
    
    private fun cargarCarruselImagenes() {
        Log.d("CarruselDebug", "Iniciando carga del carrusel de imágenes")
        Log.d("CarruselDebug", "Equipo: ${equipo?.id}")
        Log.d("CarruselDebug", "Fotos del equipo: ${equipo?.fotos}")
        Log.d("CarruselDebug", "Foto del equipo: ${equipo?.foto}")
        
        val listaImagenes = (equipo?.fotos ?: listOfNotNull(equipo?.foto))
            .filter { !it.isNullOrBlank() }
        
        Log.d("CarruselDebug", "Lista de imágenes filtrada: $listaImagenes")
        Log.d("CarruselDebug", "Cantidad de imágenes: ${listaImagenes.size}")
        
        if (listaImagenes.isNotEmpty()) {
            Log.d("CarruselDebug", "Configurando adapter con ${listaImagenes.size} imágenes")
            val adapter = CarruselImagenesAdapter(listaImagenes)
            viewPagerImagenes.adapter = adapter
            
            // Configurar indicador de páginas
            setupIndicadorPaginas(listaImagenes.size)
            
            // Listener para cambios de página
            viewPagerImagenes.registerOnPageChangeCallback(object : androidx.viewpager2.widget.ViewPager2.OnPageChangeCallback() {
                override fun onPageSelected(position: Int) {
                    Log.d("CarruselDebug", "Página seleccionada: $position")
                    actualizarIndicadorPaginas(position, listaImagenes.size)
                }
            })
        } else {
            Log.d("CarruselDebug", "No hay imágenes, mostrando placeholder")
            // Si no hay imágenes, mostrar placeholder
            val adapter = CarruselImagenesAdapter(listOf(""))
            viewPagerImagenes.adapter = adapter
        }
    }
    
    private fun setupIndicadorPaginas(totalImagenes: Int) {
        indicadorPaginas.removeAllViews()
        
        for (i in 0 until totalImagenes) {
            val dot = ImageView(requireContext()).apply {
                setImageResource(R.drawable.ic_dot)
                val params = LinearLayout.LayoutParams(
                    LinearLayout.LayoutParams.WRAP_CONTENT,
                    LinearLayout.LayoutParams.WRAP_CONTENT
                ).apply {
                    marginEnd = resources.getDimensionPixelSize(R.dimen.dot_margin)
                }
                layoutParams = params
            }
            indicadorPaginas.addView(dot)
        }
        
        actualizarIndicadorPaginas(0, totalImagenes)
    }
    
    private fun actualizarIndicadorPaginas(posicionActual: Int, totalImagenes: Int) {
        for (i in 0 until indicadorPaginas.childCount) {
            val dot = indicadorPaginas.getChildAt(i) as ImageView
            if (i == posicionActual) {
                dot.setImageResource(R.drawable.ic_dot_selected)
            } else {
                dot.setImageResource(R.drawable.ic_dot)
            }
        }
    }

