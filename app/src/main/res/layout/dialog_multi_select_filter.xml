<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/txtTituloFiltro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona opciones"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etBuscarFiltro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buscar"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="@drawable/blue_border_background"
        android:layout_marginBottom="8dp"
        android:singleLine="true"
        android:inputType="text"/>

    <Button
        android:id="@+id/btnMarcarCoincidentes"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="Marcar 0 coincidentes"
        android:textColor="#2196F3"
        android:background="@drawable/btn_accept_border"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerOpcionesFiltro"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarThumbVertical="@android:color/darker_gray"
        android:background="@drawable/blue_border_background"
        android:layout_margin="2dp"
        android:padding="8dp"/>

    <!-- Checkboxes para filtros de flota -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp">
        <CheckBox
            android:id="@+id/checkboxVerInactivos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ver inactivos"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:checked="false"/>
        <CheckBox
            android:id="@+id/checkboxVerMonitorizados"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="monit."
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:checked="false"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">
        <Button
            android:id="@+id/btnCancelarFiltro"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="CANCELAR"
            android:textColor="#8BC34A"
            android:background="@drawable/btn_cancel_border"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_marginEnd="8dp"/>
        <Button
            android:id="@+id/btnAceptarFiltro"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="ACEPTAR"
            android:textColor="#2196F3"
            android:background="@drawable/btn_accept_border"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"/>
    </LinearLayout>

</LinearLayout>