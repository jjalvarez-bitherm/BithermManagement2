<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/background_primary">

    <!-- Logo/Icono -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="32dp"
        android:src="@drawable/ic_connect_venue"
        android:contentDescription="MeetMe Logo" />

    <!-- Título -->
    <TextView
        android:id="@+id/tv_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MeetMe"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/tv_subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conecta con personas cerca de ti o en lugares específicos"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:textAlignment="center"
        android:layout_marginBottom="48dp" />

    <!-- Botón Modo Cercanía -->
    <Button
        android:id="@+id/btn_modo_cercania"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="📍 Modo Cercanía"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/button_primary"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp"
        android:drawableStart="@drawable/ic_location"
        android:drawablePadding="12dp" />

    <!-- Botón Modo Estancia -->
    <Button
        android:id="@+id/btn_modo_estancia"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🏢 Modo Estancia"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/button_secondary"
        android:textColor="@color/white"
        android:drawableStart="@drawable/ic_building"
        android:drawablePadding="12dp" />

    <!-- Información adicional -->
    <TextView
        android:id="@+id/tv_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Elige cómo quieres conocer a otras personas"
        android:textSize="14sp"
        android:textColor="@color/text_tertiary"
        android:textAlignment="center"
        android:layout_marginTop="32dp" />

</LinearLayout>
