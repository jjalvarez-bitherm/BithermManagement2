<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bitherm_gradient"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="120dp">

            <!-- Título principal -->
            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configuración de Inspección"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:gravity="center"
            android:layout_marginBottom="18dp" />

        <!-- FECHA Y NÚMERO DE INSPECCIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_field"
            android:padding="16dp">
            
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/txtFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024-12-20"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nº Inspección"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:id="@+id/txtNumeroInspeccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONFIGURACIÓN SIMPLIFICADA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Configuración de Datos"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/bg_resumen_transparente"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Selector de Libro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                    android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:text="Libro de trabajo:"
                android:textColor="#333333"
                android:textSize="14sp"
                        android:textStyle="bold"
                android:gravity="start|center_vertical" />
                    <Spinner
                        android:id="@+id/spinnerLibro"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                android:layout_weight="0.5"
                android:background="@drawable/bg_spinner_rounded"
                android:padding="8dp"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

        <!-- Selector Hoja FLOTA -->
                <LinearLayout
            android:layout_width="match_parent"
                    android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:text="Hoja de Flota:"
                android:textColor="#333333"
                android:textSize="14sp"
                        android:textStyle="bold"
                android:gravity="start|center_vertical" />
                    <Spinner
                android:id="@+id/spinnerHojaFlota"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                android:layout_weight="0.5"
                android:background="@drawable/bg_spinner_rounded"
                android:padding="8dp"
                        android:spinnerMode="dropdown" />
            </LinearLayout>

        <!-- Selector Hoja Inspección Actual -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:text="Hoja Inspección:"
                android:textColor="#333333"
                android:textSize="14sp"
                    android:textStyle="bold"
                android:gravity="start|center_vertical" />
                <Spinner
                android:id="@+id/spinnerHojaInspeccion"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                android:layout_weight="0.5"
                android:background="@drawable/bg_spinner_rounded"
                android:padding="8dp"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

        <!-- Selector Hoja Reparaciones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">
                    <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:text="Hoja Reparaciones:"
                android:textColor="#333333"
                android:textSize="14sp"
                        android:textStyle="bold"
                android:gravity="start|center_vertical" />
                    <Spinner
                android:id="@+id/spinnerHojaReparaciones"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                android:layout_weight="0.5"
                android:background="@drawable/bg_spinner_rounded"
                android:padding="8dp"
                        android:spinnerMode="dropdown" />
            </LinearLayout>

            <!-- Título sección -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gestión de datos:"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- Botones gestión de datos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="18dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDescargar"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.48"
                    android:text="DESCARGAR"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:layout_marginEnd="4dp"
                    android:letterSpacing="-0.07"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp" />
                <ImageView
                    android:id="@+id/imgBorrar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_delete"
                    android:contentDescription="Borrar"
                    android:padding="4dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/md_theme_errorContainer" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActualizar"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.48"
                    android:text="ACTUALIZAR"
                    app:icon="@drawable/ic_update"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:letterSpacing="-0.07"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- Título sección -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gestión de fotos:"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- Botones gestión de fotos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="18dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDescargarFotos"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                android:layout_weight="0.48"
                android:text="CARGAR"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:layout_marginEnd="4dp"
                    android:letterSpacing="-0.07"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp" />
            <ImageView
                android:id="@+id/imgBorrarFotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_delete"
                android:contentDescription="Borrar fotos"
                android:padding="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/md_theme_errorContainer" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActualizarFotos"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                android:layout_weight="0.48"
                    android:text="ACTUALIZAR"
                    app:icon="@drawable/ic_update"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:letterSpacing="-0.07"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- Título sección -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumen de la base de datos:"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

        <!-- Primer cuadro: Resumen base de datos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_resumen_transparente"
                android:padding="16dp"
            android:layout_marginBottom="12dp">
                <TextView
                    android:id="@+id/txtTotalEquipos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total equipos: 0"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/txtInspeccionados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Equipos inspeccionados: 0"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/txtModificados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Equipos modificados: 0"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />
        </LinearLayout>

        <!-- Segundo cuadro: Resumen de los datos en la hoja FLOTA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resumen de los datos en la hoja FLOTA:"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_resumen_transparente"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:id="@+id/txtActivos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipos activos: 0"
                android:textColor="@android:color/white"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/txtMonitorizados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipos monitorizados: 0"
                android:textColor="@android:color/white"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/txtAfsEliminados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipos AFS/Eliminados: 0"
                android:textColor="@android:color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Tercer cuadro: Resumen de Drive -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resumen de Drive:"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_resumen_transparente"
            android:padding="16dp"
            android:layout_marginBottom="18dp">
                <TextView
                    android:id="@+id/txtFotosDrive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:text="Fotos en Google Drive: 0"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/txtFotosNuevas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:text="Fotos en móvil: 0"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/txtFotosPendientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:text="Fotos pte. de subir: 0"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Título sección -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opciones avanzadas:"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- Botones opciones avanzadas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopiarDB"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COPIAR\nDB"
                    android:textSize="12sp"
                    android:singleLine="false"
                    android:layout_marginEnd="4dp"
                    android:letterSpacing="-0.07"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalibrarPantalla"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="CALIBRAR\nPANTALLA"
                    android:textSize="12sp"
                    android:singleLine="false"
                    android:layout_marginEnd="4dp"
                    android:letterSpacing="-0.07"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuscarActualizaciones"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="BUSCAR\nACTUALIZACIONES"
                    android:textSize="12sp"
                    android:singleLine="false"
                    android:layout_marginEnd="4dp"
                    android:letterSpacing="-0.07"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

        <!-- Barra de carga -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView> 
